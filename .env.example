# Points the React app at your running backend. The default matches
# `server/.env.example`'s PORT — change both together if you use a
# different port.
VITE_API_URL=http://localhost:5000/api

# Week 9: the API requires an API key from every consumer, including our
# own front end. Paste one of the comma-separated keys from server/.env
# (API_KEYS) here — use the team's own key, not the partner's.
VITE_API_KEY=
