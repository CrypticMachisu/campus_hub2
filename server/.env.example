# Copy this file to .env and adjust if your XAMPP MySQL setup differs
# from the defaults (XAMPP's MySQL normally runs on port 3306 with the
# "root" user and no password).

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=campushub

# Any long random string works — used to sign login tokens.
JWT_SECRET=change-this-to-something-long-and-random

# Port the API server itself listens on.
PORT=5000

# Default password given to every seeded demo account (see seed.js).
# Change this if you don't want it to be predictable.
SEED_PASSWORD=campushub123
