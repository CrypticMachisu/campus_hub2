# Copy this file to .env and adjust if your XAMPP MySQL setup differs
# from the defaults (XAMPP's MySQL normally runs on port 3306 with the
# "root" user and no password).

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
# The standalone edition owns this database. The coursework database is
# `campushub`; nothing in this branch reads or writes it.
DB_NAME=campushub_standalone

# Any long random string works — used to sign login tokens.
JWT_SECRET=change-this-to-something-long-and-random

# Week 9: API keys, one per consumer (never share one). Comma-separated.
# Keys live here, in the environment — never in source code or git.
# Generate one: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
API_KEYS=,  # e.g. <partner-key>,<own-team-test-key>

# Week 9: rate limit per key (100 requests per 60 s is the default).
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000

# Port the API server itself listens on.
PORT=5000

# Browser origins allowed to call the API, comma-separated. Server-to-server
# calls (curl, the partner, the test suites) send no Origin and are unaffected.
# Add your deployed frontend's origin here; "*" allows any browser origin.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

PUBLIC_URL=https://your-ngrok-url.ngrok-free.dev

# Default password given to every seeded demo account (see seed.js).
# Change this if you don't want it to be predictable.
SEED_PASSWORD=campushub123

# Post photos (Cloudflare R2 or any S3-compatible store). Leave these blank to
# keep text posts working without photo controls. Use R2_* for Cloudflare, or
# S3_* for another provider. R2_BUCKET_NAME/R2_ACCESS_KEY_ID/... are read when
# the matching S3_* value is absent.
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=
# A public bucket domain makes image URLs stable. Without it the API returns
# one-hour signed GET URLs, so a private bucket is fine.
# R2_PUBLIC_BASE_URL=
# S3_ENDPOINT=
# S3_REGION=auto
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PUBLIC_BASE_URL=
# S3_FORCE_PATH_STYLE=false
# Pending uploads older than this are deleted by the cleanup worker. It runs
# only when storage is configured; MEDIA_CLEANUP=off is a kill switch.
MEDIA_PURGE_HOURS=24
MEDIA_CLEANUP=on

# Commitment reminder emails (Resend). Leave both blank to keep the worker off.
# REMINDER_FROM must be a verified sender/domain in Resend, e.g.
# "Kesho <reminders@your-domain.example>".
RESEND_API_KEY=
REMINDER_FROM=
# How far ahead to remind, and how often to sweep. EMAIL_REMINDERS=off is a
# hard kill switch even when keys are present.
REMINDER_HOURS=24
REMINDER_INTERVAL_MINUTES=10
EMAIL_REMINDERS=on
