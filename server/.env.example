# Copy this file to .env and adjust if your XAMPP MySQL setup differs
# from the defaults (XAMPP's MySQL normally runs on port 3306 with the
# "root" user and no password).

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=campushub

# Any long random string works — used to sign login tokens.
JWT_SECRET=change-this-to-something-long-and-random

# Week 9: API keys, one per consumer (never share one). Comma-separated.
# Keys live here, in the environment — never in source code or git.
# Generate one: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
API_KEYS=,  # e.g. <partner-key>,<own-team-test-key>

# Week 9: rate limit per key (100 requests per 60 s is the default).
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000

# Port the API server itself listens on.
PORT=5000

PUBLIC_URL=https://your-ngrok-url.ngrok-free.dev
PARTNER_URL=https://farmers-agroconnect.onrender.com/api
PARTNER_API_KEY=

# Default password given to every seeded demo account (see seed.js).
# Change this if you don't want it to be predictable.
SEED_PASSWORD=campushub123
