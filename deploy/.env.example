# Copy to deploy/.env and replace every value marked change-me.
# Compose reads this file automatically when started with:
#   docker compose --env-file deploy/.env up -d --build

MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_PASSWORD=change-me-app

# Long random strings:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-jwt-secret

# Comma-separated. The first key is also used by the browser build.
# node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
API_KEYS=change-me-api-key
VITE_API_KEY=change-me-api-key

# Public origin users open in a browser. Keep these in sync.
# For the TLS profile these must use https:// and the same DNS name as
# SITE_ADDRESS. For local HTTP use http://localhost:8080 instead.
PUBLIC_URL=https://change-me.example.com
CORS_ORIGINS=https://change-me.example.com

# TLS profile (`--profile tls`). Use a DNS name that points at this host; Caddy
# obtains and renews the certificate automatically. Use localhost only for a
# local test with Caddy's internal CA.
SITE_ADDRESS=change-me.example.com

# Host ports. Bound to loopback so the optional TLS proxy is the only public
# entry point. API is exposed for local health checks and direct clients.
WEB_PORT=8080
API_PORT=5000

# First boot only. The production default is schema-only; use the demo database
# only for a disposable pilot stack, never with real users.
BOOTSTRAP_SQL=./server/campushub_schema.sql

# First tier 1 operator, used once by `npm run bootstrap:admin` on a schema-only
# database. Leave empty for the demo database. The password is never printed.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_NAME=Campus operator
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_CAMPUS_NAME=
BOOTSTRAP_CAMPUS_SLUG=
BOOTSTRAP_CAMPUS_DOMAIN=

RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000

# Demo/pilot only. Used once by `npm run set-passwords`; do not reuse it for
# real accounts. Production accounts should be created by an operator.
SEED_PASSWORD=change-me-demo-password
CROSS_UNIVERSITY_ENABLED=false

# Ignore email for this deployment. Photo storage remains optional.
EMAIL_REMINDERS=off
MEDIA_CLEANUP=on
MEDIA_PURGE_HOURS=24
