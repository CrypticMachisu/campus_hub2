{
	# The only clients are browsers through this proxy; leave Caddy's admin API
	# off the network.
	admin off
}

# For production use a public DNS name, e.g. SITE_ADDRESS=kesho.example.com.
# Caddy obtains and renews the certificate automatically. localhost uses
# Caddy's local CA, which is only suitable for testing.
{$SITE_ADDRESS:localhost} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}

	# Send API traffic straight to Node. The web container also proxies /api for
	# non-TLS local use, but bypassing that extra hop preserves the real client
	# address and X-Forwarded-Proto for rate limiting.
	handle /api/* {
		reverse_proxy api:5000
	}

	handle {
		reverse_proxy web:80
	}
}
